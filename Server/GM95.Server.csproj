<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- May chi cai .NET moi hon (vd Ubuntu 26.04 chi co .NET 10) van chay duoc:
         co runtime 8.0 thi dung 8.0, khong co thi tu nhay len ban major cao hon. -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>GM95.Server</RootNamespace>
    <AssemblyName>GM95.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- config.json la nguon su that cau hinh; copy ra output de doc canh binary. -->
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="doa.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- File .sql migration/seed cua tung app (server-side) phai co canh binary. -->
    <None Update="Apps\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
