<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GM95.App.ManagerPerformance.ViewModels.Pages"
             xmlns:models="using:GM95.App.ManagerPerformance.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="GM95.App.ManagerPerformance.Views.Pages.BomView"
             x:DataType="vm:BomViewModel">

    <!-- 2 COT: trai = danh sach MA HANG; phai = phien ban BOM + dinh muc cua ma hang. -->
    <!-- Cot giua = thanh KEO: tu chinh do rong cot trai. -->
    <Grid ColumnDefinitions="288,Auto,*">

        <!-- ===== COT TRAI: danh sach ma hang ===== -->
        <Border Classes="card" Grid.Column="0" Margin="0,0,10,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Classes="h2" Text="Mã hàng" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="ghost" Content="⟳" Command="{Binding LoadCommand}"
                            ToolTip.Tip="Làm mới danh sách"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,6">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding FilterMonthOptions}" SelectedItem="{Binding FilterMonth}" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding FilterYearOptions}" SelectedItem="{Binding FilterYear}" HorizontalAlignment="Stretch"/>
                </Grid>
                <TextBox Grid.Row="2" Text="{Binding ListFilter}" Watermark="Tìm tên / SKU mã hàng..." Margin="0,0,0,8"/>
                <ListBox Grid.Row="3" Classes="master" ItemsSource="{Binding FilteredProducts}"
                         SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <StackPanel Spacing="1">
                                <TextBlock Classes="itemmain" Text="{Binding Name}"/>
                                <TextBlock Classes="itemsub" Text="{Binding Sku}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== COT PHAI: phien ban BOM + dinh muc ===== -->
        <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>

        <Grid Grid.Column="2" RowDefinitions="*,*,Auto">

        <!-- Cac phien ban BOM: tao ban moi + duyet ngay trong cung card -->
        <Border Classes="card" Grid.Row="0">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Classes="h2" Text="Các phiên bản BOM" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="ghost" Content="Gửi duyệt" Margin="0,0,8,0"
                            Command="{Binding SubmitCommand}"/>
                    <Button Grid.Column="2" Classes="accent" Content="Duyệt (ACTIVE)" Margin="0,0,8,0"
                            Command="{Binding ApproveCommand}"/>
                    <Button Grid.Column="3" Classes="ghost" Content="Từ chối" Margin="0,0,8,0"
                            Command="{Binding RejectCommand}"/>
                    <Button Grid.Column="4" Classes="danger" Content="Xoá BOM"
                            Command="{Binding DeleteBomCommand}"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBox Grid.Column="0" Text="{Binding NewBomNote}" Watermark="Ghi chú bản định mức mới"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Classes="accent" Content="+ Tạo BOM"
                            Command="{Binding CreateBomCommand}" IsEnabled="{Binding !IsBusy}"/>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Boms}" SelectedItem="{Binding SelectedBom}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="86"/>
                        <DataGridTextColumn Header="Phiên bản" Binding="{Binding Version}" Width="*" MinWidth="90"/>
                        <DataGridTemplateColumn Header="Trạng thái" Width="*" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource CodeVi}}" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Margin="12,0,0,0"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="3*" MinWidth="220"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Dinh muc cua BOM dang chon -->
        <Border Classes="card" Grid.Row="1" Margin="0,12,0,0">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Classes="h2" Text="Định mức của BOM đang chọn" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="accent" Content="+ Thêm nhiều NVL (cửa sổ riêng)"
                            Command="{Binding AddManyItemsCommand}"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="2*,*,*,Auto,Auto" Margin="0,0,0,10">
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="Nguyên vật liệu (thêm/sửa nhanh 1 dòng)"/>
                        <AutoCompleteBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                              FilterMode="Contains" MinimumPrefixLength="0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="ĐM/đơn vị"/>
                        <NumericUpDown Value="{Binding NewQtyPerUnit, TargetNullValue=0}" Minimum="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="Hao hụt %"/>
                        <NumericUpDown Value="{Binding NewWastePct, TargetNullValue=0}" Minimum="0"/>
                    </StackPanel>
                    <Button Grid.Column="3" Classes="accent" Content="Lưu định mức" Margin="0,0,8,0"
                            VerticalAlignment="Bottom" Command="{Binding AddItemCommand}"/>
                    <Button Grid.Column="4" Classes="danger" Content="Xoá dòng"
                            VerticalAlignment="Bottom" Command="{Binding DeleteItemCommand}"
                            IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" IsReadOnly="True"
                          SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NVL" Binding="{Binding MaterialId}" Width="86"/>
                        <DataGridTextColumn Header="Tên NVL" Binding="{Binding MaterialName}" Width="2*" MinWidth="180"/>
                        <DataGridTemplateColumn Header="ĐM/đơn vị" Width="*" MinWidth="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding QtyPerUnit, StringFormat='{}{0:0.####}'}"/>
                                        <TextBlock Text="{Binding MaterialUomName}" Classes="uom"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Hao hụt %" Width="*" MinWidth="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WastePct, StringFormat='{}{0:0.####}'}"/>
                                        <TextBlock Text="%" Classes="uom"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="2*" MinWidth="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Status}" Margin="0,8,0,0"/>

        </Grid>
    </Grid>
</UserControl>
