<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DGroup.App.ManagerPerformance.ViewModels.Pages"
             xmlns:models="using:DGroup.App.ManagerPerformance.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="DGroup.App.ManagerPerformance.Views.Pages.RoutingsView"
             x:DataType="vm:RoutingsViewModel">
    <!-- Trai = danh sach mau quy trinh; phai = chi tiet mau dang chon + danh muc cong doan. -->
    <Grid ColumnDefinitions="288,*">

        <!-- ===== COT TRAI: danh sach mau quy trinh ===== -->
        <Border Classes="card" Grid.Column="0" Margin="0,0,10,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Classes="h2" Text="Mẫu quy trình"/>
                    <Button Grid.Column="1" Classes="ghost" Content="⟳" Command="{Binding LoadCommand}"
                            ToolTip.Tip="Làm mới danh sách"/>
                </Grid>
                <TextBox Grid.Row="1" Text="{Binding ListFilter}" Watermark="Tìm tên / mã quy trình..." Margin="0,0,0,8"/>
                <ListBox Grid.Row="2" Classes="master" ItemsSource="{Binding FilteredRoutings}"
                         SelectedItem="{Binding SelectedRouting, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Routing">
                            <StackPanel Spacing="1">
                                <TextBlock Classes="itemmain" Text="{Binding Name}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="itemsub" Text="{Binding Code}"/>
                                    <TextBlock Classes="itemsub" Text="{Binding StepCount, StringFormat='{}{0} bước'}"/>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#16A34A"
                                               Text="mặc định" IsVisible="{Binding IsDefault}"/>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"
                                               Text="ngừng dùng" IsVisible="{Binding !IsActive}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="3" Classes="accent" Content="+ Tạo mẫu quy trình" Margin="0,8,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding NewRoutingCommand}" IsEnabled="{Binding !IsBusy}"/>
            </Grid>
        </Border>

        <!-- ===== COT PHAI ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

            <!-- Thao tac tren mau dang chon -->
            <Border Classes="card" Grid.Row="0" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="h2" Text="{Binding SelectedRouting.Name, FallbackValue='Chưa chọn mẫu quy trình'}"/>
                        <TextBlock Classes="muted" Text="{Binding SelectedRouting.Note}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="accent" Content="✎ Sửa mẫu" Margin="0,0,8,0"
                            Command="{Binding EditRoutingCommand}"
                            IsEnabled="{Binding SelectedRouting, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Grid.Column="2" Classes="danger" Content="Xoá mẫu"
                            Command="{Binding DeleteRoutingCommand}"
                            IsEnabled="{Binding SelectedRouting, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Grid>
            </Border>

            <!-- Trai: cac buoc cua mau | Phai: danh muc cong doan -->
            <Grid Grid.Row="1" ColumnDefinitions="2*,*">

                <Border Classes="card" Grid.Column="0" Margin="0,0,6,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Classes="h2" Text="Các bước của mẫu đang chọn" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TT" Binding="{Binding Seq}" Width="60"/>
                                <DataGridTextColumn Header="Mã công đoạn" Binding="{Binding Stage.Code}" Width="*" MinWidth="140"/>
                                <DataGridTextColumn Header="Tên công đoạn" Binding="{Binding Stage.Name}" Width="2*" MinWidth="180"/>
                                <DataGridTemplateColumn Header="Có thể bỏ" Width="*" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="{Binding IsOptional, Converter={StaticResource BoolToOptional}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="2*" MinWidth="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Classes="card" Grid.Column="1" Margin="6,0,0,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <TextBlock Grid.Column="0" Classes="h2" Text="Danh mục công đoạn"/>
                            <Button Grid.Column="1" Classes="ghost" Content="+ Thêm"
                                    Command="{Binding NewStageCommand}" IsEnabled="{Binding !IsBusy}"/>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Stages}"
                                  SelectedItem="{Binding SelectedCatalogStage}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TT" Binding="{Binding Seq}" Width="52"/>
                                <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="*" MinWidth="110"/>
                                <DataGridTextColumn Header="Tên công đoạn" Binding="{Binding Name}" Width="2*" MinWidth="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Classes="ghost" Content="✎ Sửa công đoạn" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding EditStageCommand}"
                                IsEnabled="{Binding SelectedCatalogStage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Status}" Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</UserControl>
