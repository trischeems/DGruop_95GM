<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GM95.App.ManagerPerformance.ViewModels.Pages"
             xmlns:models="using:GM95.App.ManagerPerformance.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="GM95.App.ManagerPerformance.Views.Pages.MaterialsView"
             x:DataType="vm:MaterialsViewModel">

    <!-- Form gon phia tren (Auto), 2 bang chia deu phan con lai (*,*) -->
    <Grid RowDefinitions="Auto,*,*,Auto">

        <!-- Form: Tao NVL + Nhap kho, 2 cot; nut hanh dong nam ngay tren header form -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,12">
            <!-- Tao NVL: bam nut -> mo CUA SO rieng de nhap (form da chuyen sang dialog). -->
            <Border Classes="card" Grid.Column="0" Margin="0,0,6,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h2" Text="Nguyên vật liệu" Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Classes="muted" Text="Tạo NVL mới trong một cửa sổ riêng để tiện nhập."/>
                        <Button Classes="accent" Content="+ Tạo nguyên vật liệu" HorizontalAlignment="Left"
                                Command="{Binding CreateMaterialCommand}" IsEnabled="{Binding !IsBusy}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nhap kho: PHIEU NHIEU DONG (them nhieu NVL vao luoi, luu 1 lan) -->
            <Border Classes="card" Grid.Column="1" Margin="6,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h2" Text="Nhập kho" Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Classes="muted" Text="Mở cửa sổ riêng để lập phiếu nhập nhiều NVL cùng lúc, lưu một lần."/>
                        <Button Classes="accent" Content="↓ Nhập kho (phiếu nhiều dòng)" HorizontalAlignment="Left"
                                Command="{Binding OpenReceiptDialogCommand}" IsEnabled="{Binding !IsBusy}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bang NVL: hang field sua tren dau bang (bam 1 dong -> tu nap; Luu / Xoa ben phai) -->
        <Border Classes="card" Grid.Row="1">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Classes="h2" Text="Danh mục nguyên vật liệu" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Classes="label" Text="Tháng" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding FilterMonthOptions}" SelectedItem="{Binding FilterMonth}" Width="100" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding FilterYearOptions}" SelectedItem="{Binding FilterYear}" Width="90" Margin="0,0,8,0"/>
                    <Button Grid.Column="4" Classes="ghost" Content="Làm mới" Command="{Binding LoadCommand}"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,2*,*,*,*,Auto,Auto,Auto" Margin="0,0,0,10"
                      IsEnabled="{Binding SelectedListMaterial, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="SKU (không sửa)"/>
                        <TextBox Text="{Binding EditSku}" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="Tên NVL"/>
                        <TextBox Text="{Binding EditName}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="Ngưỡng tồn thấp"/>
                        <NumericUpDown Value="{Binding EditReorderLevel, TargetNullValue=0}" Minimum="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="Cỡ lô mua"/>
                        <NumericUpDown Value="{Binding EditReorderQuantity, TargetNullValue=0}" Minimum="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="Đơn giá (VND)"/>
                        <NumericUpDown Classes="money" Value="{Binding EditStandardCost, TargetNullValue=0}" Minimum="0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="5" Content="Hoạt động" IsChecked="{Binding EditIsActive}"
                              VerticalAlignment="Bottom" Margin="0,0,10,4"/>
                    <Button Grid.Column="6" Classes="accent" Content="Lưu" Margin="0,0,8,0"
                            VerticalAlignment="Bottom" Command="{Binding SaveMaterialCommand}"/>
                    <Button Grid.Column="7" Classes="danger" Content="Xoá"
                            VerticalAlignment="Bottom" Command="{Binding DeleteMaterialCommand}"/>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Materials}" IsReadOnly="True"
                          SelectedItem="{Binding SelectedListMaterial}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="86"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*" MinWidth="130"/>
                        <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="2*" MinWidth="220"/>
                        <DataGridTemplateColumn Header="Ngưỡng tồn" Width="*" MinWidth="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ReorderLevel, StringFormat='{}{0:0.####}'}"/>
                                        <TextBlock Text="{Binding UomName}" Classes="uom"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Cỡ lô" Width="*" MinWidth="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ReorderQuantity, StringFormat='{}{0:0.####}'}"/>
                                        <TextBlock Text="{Binding UomName}" Classes="uom"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Đơn giá (VND)" Binding="{Binding StandardCost, StringFormat='{}{0:#,##0}'}" Width="*" MinWidth="120"/>
                        <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" Width="0.6*" MinWidth="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Row 2: trai = bang ton kho (co cot gia); phai = lich su giao dich cua NVL dang chon -->
        <Grid Grid.Row="2" ColumnDefinitions="3*,Auto,2*" Margin="0,12,0,0">
            <Border Classes="card" Grid.Column="0" Margin="0,0,6,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h2" Text="Tồn kho khả dụng (bấm 1 dòng để xem lịch sử giá)" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Stock}" SelectedItem="{Binding SelectedStockRow}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NVL ID" Binding="{Binding MaterialId}" Width="86"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="2*" MinWidth="180"/>
                            <DataGridTemplateColumn Header="Tồn thực" Width="*" MinWidth="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalOnHand, StringFormat='{}{0:0.####}'}"/>
                                            <TextBlock Text="{Binding UomName}" Classes="uom"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Khả dụng" Width="*" MinWidth="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalAvailable, StringFormat='{}{0:0.####}'}"/>
                                            <TextBlock Text="{Binding UomName}" Classes="uom"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Đơn giá gần nhất" Binding="{Binding LastUnitCost, StringFormat='{}{0:#,##0}'}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="Giá trị tồn (VND)" Binding="{Binding StockValue, StringFormat='{}{0:#,##0}'}" Width="*" MinWidth="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>
            <Border Classes="card" Grid.Column="2" Margin="6,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h2" Text="Lịch sử nhập / xuất (đơn giá từng lần)" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding History}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Loại" Width="Auto" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TxnType, Converter={StaticResource CodeVi}}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0"
                                                   Foreground="{Binding TxnType, Converter={StaticResource StatusToBrush}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SL" Width="*" MinWidth="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Quantity, StringFormat='{}{0:0.####}'}"/>
                                            <TextBlock Text="{Binding MaterialUomName}" Classes="uom"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitCost, StringFormat='{}{0:#,##0}'}" Width="*" MinWidth="90"/>
                            <DataGridTemplateColumn Header="Tồn sau" Width="*" MinWidth="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BalanceAfter, StringFormat='{}{0:0.####}'}"/>
                                            <TextBlock Text="{Binding MaterialUomName}" Classes="uom"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yy HH:mm}'}" Width="*" MinWidth="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Classes="muted" Text="{Binding Status}" Margin="0,8,0,0"/>

    </Grid>
</UserControl>
