<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GM95.App.ManagerPerformance.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="GM95.App.ManagerPerformance.Views.Pages.ProductionOrdersView"
             x:DataType="vm:ProductionOrdersViewModel">

    <!-- Form tao don (Auto), danh sach don (*), giu cho + nhu cau (*) -->
    <Grid RowDefinitions="Auto,*,*,Auto">

        <!-- Card: Tao don san xuat -> mo CUA SO rieng de nhap. -->
        <Border Classes="card" Grid.Row="0" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Classes="h2" Text="Đơn sản xuất"/>
                    <TextBlock Classes="muted" Text="Tạo đơn mới trong một cửa sổ riêng cho tiện nhập."/>
                </StackPanel>
                <Button Grid.Column="1" Classes="accent" Content="+ Tạo đơn" VerticalAlignment="Center"
                        Command="{Binding CreateCommand}" IsEnabled="{Binding !IsBusy}"/>
            </Grid>
        </Border>

        <!-- Card: Danh sach don + hang sua tren dau bang + hanh dong tren don dang chon -->
        <Border Classes="card" Grid.Row="1">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Classes="h2" Text="Danh sách đơn" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Classes="label" Text="Tháng" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding FilterMonthOptions}" SelectedItem="{Binding FilterMonth}" Width="100" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding FilterYearOptions}" SelectedItem="{Binding FilterYear}" Width="90" Margin="0,0,8,0"/>
                    <Button Grid.Column="4" Classes="accent" Content="Xác nhận + Giữ chỗ" Margin="0,0,8,0"
                            Command="{Binding ConfirmCommand}"/>
                    <Button Grid.Column="5" Classes="ghost" Content="Huỷ đơn" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"/>
                    <Button Grid.Column="6" Classes="ghost" Content="Làm mới" Command="{Binding LoadCommand}"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto,Auto" Margin="0,0,0,10"
                      IsEnabled="{Binding SelectedOrder, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="Số đơn (không sửa)"/>
                        <TextBox Text="{Binding EditOrderNo}" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="Số lượng (chỉ đơn DRAFT)"/>
                        <NumericUpDown Value="{Binding EditQuantity, TargetNullValue=0}" Minimum="0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="accent" Content="Lưu" Margin="0,0,8,0"
                            VerticalAlignment="Bottom" Command="{Binding SaveOrderCommand}"/>
                    <Button Grid.Column="3" Classes="danger" Content="Xoá"
                            VerticalAlignment="Bottom" Command="{Binding DeleteOrderCommand}"/>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="86"/>
                        <DataGridTextColumn Header="Số đơn" Binding="{Binding OrderNo}" Width="2*" MinWidth="140"/>
                        <DataGridTextColumn Header="Mã hàng" Binding="{Binding ProductId}" Width="86"/>
                        <DataGridTextColumn Header="Tên mã hàng" Binding="{Binding ProductName}" Width="2*" MinWidth="180"/>
                        <DataGridTemplateColumn Header="SL" Width="*" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Quantity, StringFormat='{}{0:0.####}'}"/>
                                        <TextBlock Text="{Binding ProductUomName}" Classes="uom"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Trạng thái" Width="*" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusLabel}" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Margin="12,0,0,0"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Chi tiet don dang chon: giu cho + nhu cau -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="0,12,0,0">
            <Border Grid.Column="0" Classes="card" Margin="0,0,6,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h2" Text="Giữ chỗ NVL" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Reservations}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NVL" Binding="{Binding MaterialId}" Width="86"/>
                            <DataGridTextColumn Header="Tên NVL" Binding="{Binding MaterialName}" Width="2*" MinWidth="150"/>
                            <DataGridTextColumn Header="Kho" Binding="{Binding WarehouseName}" Width="*" MinWidth="90"/>
                            <DataGridTemplateColumn Header="Giữ chỗ" Width="*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding QtyReserved, StringFormat='{}{0:0.####}'}"/>
                                            <TextBlock Text="{Binding MaterialUomName}" Classes="uom"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Converter={StaticResource CodeVi}}" Width="*" MinWidth="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>
            <Border Grid.Column="2" Classes="card" Margin="6,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h2" Text="Nhu cầu / thiếu hụt" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Requirements}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NVL" Binding="{Binding MaterialId}" Width="86"/>
                            <DataGridTextColumn Header="Tên NVL" Binding="{Binding MaterialName}" Width="2*" MinWidth="150"/>
                            <DataGridTemplateColumn Header="Cần" Width="*" MinWidth="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RequiredQty, StringFormat='{}{0:0.####}'}"/>
                                            <TextBlock Text="{Binding MaterialUomName}" Classes="uom"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Khả dụng" Width="*" MinWidth="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalAvailable, StringFormat='{}{0:0.####}'}"/>
                                            <TextBlock Text="{Binding MaterialUomName}" Classes="uom"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Thiếu" Width="*" MinWidth="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortageQty, StringFormat='{}{0:0.####}'}"/>
                                            <TextBlock Text="{Binding MaterialUomName}" Classes="uom"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Đề xuất mua" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SuggestedPurchaseQty, StringFormat='{}{0:0.####}'}"/>
                                            <TextBlock Text="{Binding MaterialUomName}" Classes="uom"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Classes="muted" Text="{Binding Status}" Margin="0,8,0,0"/>

    </Grid>
</UserControl>
