<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GM95.App.ManagerPerformance.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560"
             x:Class="GM95.App.ManagerPerformance.Views.Dialogs.ProductFormView"
             x:DataType="vm:ProductsViewModel">
    <!-- Than form Tao ma hang — hien trong cua so dialog rieng. -->
    <StackPanel Spacing="12">
        <StackPanel>
            <TextBlock Classes="label" Text="SKU"/>
            <TextBox Text="{Binding NewSku}" Watermark="VD: SP-001"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Classes="label" Text="Tên mã hàng"/>
            <TextBox Text="{Binding NewName}" Watermark="VD: Áo sơ mi"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Classes="label" Text="Đơn vị tính"/>
            <AutoCompleteBox ItemsSource="{Binding Uoms}" SelectedItem="{Binding SelectedUom, Mode=TwoWay}"
                             FilterMode="Contains" MinimumPrefixLength="0" HorizontalAlignment="Stretch"/>
        </StackPanel>
    </StackPanel>
</UserControl>
