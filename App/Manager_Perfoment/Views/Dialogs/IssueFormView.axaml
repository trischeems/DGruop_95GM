<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GM95.App.ManagerPerformance.ViewModels.Pages"
             xmlns:models="using:GM95.App.ManagerPerformance.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="460"
             x:Class="GM95.App.ManagerPerformance.Views.Dialogs.IssueFormView"
             x:DataType="vm:ProductionViewModel">
    <!-- Phieu XUAT NVL nhieu dong: trai = danh sach NVL (tim+chon); phai = kho + nhap dong + luoi. -->
    <!-- Cot giua = thanh KEO: tu chinh do rong danh sach ben trai. -->
    <Grid ColumnDefinitions="260,Auto,*">

        <!-- ===== COT TRAI: danh sach NVL ===== -->
        <Border Classes="card" Grid.Column="0" Margin="0,0,10,0">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0" Classes="h2" Text="Nguyên vật liệu" Margin="0,0,0,8"/>
                <TextBox Grid.Row="1" Text="{Binding MaterialListFilter}" Watermark="Tìm tên / SKU..." Margin="0,0,0,8"/>
                <ListBox Grid.Row="2" Classes="master" ItemsSource="{Binding FilteredMaterials}"
                         SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Material">
                            <StackPanel Spacing="1">
                                <TextBlock Classes="itemmain" Text="{Binding Name}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="itemsub" Text="{Binding Sku}"/>
                                    <TextBlock Classes="itemsub" Text="{Binding UomName}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== COT PHAI: kho + nhap dong + luoi ===== -->
        <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>

        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Classes="label" Text="Kho xuất (áp dụng cho cả phiếu)"/>
                <AutoCompleteBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse, Mode=TwoWay}"
                                 FilterMode="Contains" MinimumPrefixLength="0" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <!-- Goi y ton con lai cua NVL dang chon (biet duong nhap so luong) -->
            <TextBlock Grid.Row="1" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,6"
                       Text="{Binding IssueAvailableText}" TextWrapping="Wrap"/>
            <Grid Grid.Row="2" ColumnDefinitions="*,*,Auto" Margin="0,0,0,8">
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Classes="label" Text="Số lượng xuất"/>
                    <NumericUpDown Value="{Binding IssueQty, TargetNullValue=0}" Minimum="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Classes="label" Text="Đơn giá (VND)"/>
                    <NumericUpDown Classes="money" Value="{Binding IssueUnitCost, TargetNullValue=0}" Minimum="0"/>
                </StackPanel>
                <Button Grid.Column="2" Classes="accent" Content="+ Thêm dòng" VerticalAlignment="Bottom"
                        Command="{Binding AddIssueLineCommand}"/>
            </Grid>
            <TextBlock Grid.Row="3" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,0,0,6"
                       Text="{Binding IssueError}" TextWrapping="Wrap"
                       IsVisible="{Binding IssueError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Grid.Row="4" Classes="muted" Margin="0,0,0,6"
                       Text="Bấm chọn NVL ở danh sách trái, nhập SL rồi '+ Thêm dòng'. Xong bấm 'Xuất kho'."/>
            <Grid Grid.Row="5" RowDefinitions="*,Auto">
                <DataGrid Grid.Row="0" ItemsSource="{Binding IssueLines}" SelectedItem="{Binding SelectedIssueLine}"
                          IsReadOnly="True" MinHeight="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NVL" Binding="{Binding Material.Sku}" Width="*" MinWidth="110"/>
                        <DataGridTextColumn Header="Tên" Binding="{Binding Material.Name}" Width="2*" MinWidth="150"/>
                        <DataGridTemplateColumn Header="SL xuất" Width="*" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding QtyIssued, StringFormat='{}{0:0.####}'}"/>
                                        <TextBlock Text="{Binding Material.UomName}" Classes="uom"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitCost, StringFormat='{}{0:#,##0}'}" Width="*" MinWidth="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="1" Classes="ghost" Content="Xoá dòng đang chọn" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding RemoveIssueLineCommand}"
                        IsEnabled="{Binding SelectedIssueLine, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
