<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DGroup.App.ManagerPerformance.ViewModels.Pages"
             xmlns:models="using:DGroup.App.ManagerPerformance.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="460"
             x:Class="DGroup.App.ManagerPerformance.Views.Dialogs.ReceiptFormView"
             x:DataType="vm:MaterialsViewModel">
    <!-- Phieu NHAP kho nhieu dong: trai = danh sach NVL (tim+chon); phai = kho + nhap dong + luoi. -->
    <Grid ColumnDefinitions="260,*">

        <!-- ===== COT TRAI: danh sach NVL ===== -->
        <Border Classes="card" Grid.Column="0" Margin="0,0,10,0">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0" Classes="h2" Text="Nguyên vật liệu" Margin="0,0,0,8"/>
                <TextBox Grid.Row="1" Text="{Binding MaterialListFilter}" Watermark="Tìm tên / SKU..." Margin="0,0,0,8"/>
                <ListBox Grid.Row="2" Classes="master" ItemsSource="{Binding FilteredMaterials}"
                         SelectedItem="{Binding ReceiveMaterial, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Material">
                            <StackPanel Spacing="1">
                                <TextBlock Classes="itemmain" Text="{Binding Name}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="itemsub" Text="{Binding Sku}"/>
                                    <TextBlock Classes="itemsub" Text="{Binding UomCode}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== COT PHAI: kho + nhap dong + luoi ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Classes="label" Text="Kho (áp dụng cho cả phiếu)"/>
                <AutoCompleteBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding ReceiveWarehouse, Mode=TwoWay}"
                                 FilterMode="Contains" MinimumPrefixLength="0" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" Margin="0,0,0,8">
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Classes="label" Text="Số lượng"/>
                    <NumericUpDown Value="{Binding ReceiveQuantity, TargetNullValue=0}" Minimum="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Classes="label" Text="Đơn giá (VND)"/>
                    <NumericUpDown Classes="money" Value="{Binding ReceiveUnitCost, TargetNullValue=0}" Minimum="0"/>
                </StackPanel>
                <Button Grid.Column="2" Classes="accent" Content="+ Thêm dòng" VerticalAlignment="Bottom"
                        Command="{Binding AddReceiptLineCommand}"/>
            </Grid>
            <TextBlock Grid.Row="2" Classes="muted" Margin="0,0,0,6"
                       Text="Bấm chọn NVL ở danh sách trái, nhập SL + đơn giá rồi '+ Thêm dòng'. Xong bấm 'Lưu phiếu nhập'."/>
            <Grid Grid.Row="3" RowDefinitions="*,Auto">
                <DataGrid Grid.Row="0" ItemsSource="{Binding ReceiptLines}" SelectedItem="{Binding SelectedReceiptLine}"
                          IsReadOnly="True" MinHeight="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NVL" Binding="{Binding Material.Sku}" Width="*" MinWidth="110"/>
                        <DataGridTextColumn Header="Tên" Binding="{Binding Material.Name}" Width="2*" MinWidth="150"/>
                        <DataGridTemplateColumn Header="SL" Width="*" MinWidth="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding QtyReceived, StringFormat='{}{0:0.####}'}"/>
                                        <TextBlock Text="{Binding Material.UomCode}" Classes="uom"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitCost, StringFormat='{}{0:#,##0}'}" Width="*" MinWidth="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="1" Classes="ghost" Content="Xoá dòng đang chọn" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding RemoveReceiptLineCommand}"
                        IsEnabled="{Binding SelectedReceiptLine, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
